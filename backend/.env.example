PORT=4000
CORS_ORIGIN=http://localhost:5174

# Local development uses built-in SQLite automatically at backend/data/debts.db.
# For production PostgreSQL (Supabase / Neon / Render), set DATABASE_URL:
# DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# Optional AI API Keys (built-in smart natural language advisor works even without a key)
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini

# Automated daily reminder cron schedule (default: 09:00 AM daily)
REMINDER_CRON=0 9 * * *

# Optional Google SMTP email alerts (in addition to dashboard + browser notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-16-char-google-app-password
# REMINDER_EMAIL_TO=your-email@gmail.com
